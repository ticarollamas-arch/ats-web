[Unit]
Description=ATS Resume Optimizer (gunicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ats-web/app
ExecStart=/opt/ats-web/venv/bin/gunicorn --workers 2 --threads 2 --timeout 60 --bind 127.0.0.1:8095 --access-logfile - server:app
Restart=always
RestartSec=3
# endurecimento básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/ats-web

[Install]
WantedBy=multi-user.target
